# ============================================================================
# Teams Call Quality Monitor - Server Configuration
# Copy this file to `.env` and fill in the values.
# ============================================================================

# ---------- Server ----------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
APP_NAME=Teams Call Quality Monitor
ORG_NAME=Contoso
# CORS_ORIGIN=https://your-frontend.example.com   # omit to allow same-origin only

# ---------- Data ----------
# Where the JSON datastore lives (must be writable by the process)
DATA_DIR=./data
# If true (default), seed demo data on empty datastore. Set to 'false' in prod
# after loading real data.
SEED_ON_EMPTY=true
SEED_COUNT=650

# ---------- SharePoint / Microsoft Graph (OPTIONAL) ----------
# Leave blank to disable SharePoint integration.
#
# The Azure AD app must have the Microsoft Graph *application* permission
# `Sites.ReadWrite.All` (or Sites.Selected + a per-site grant), with admin
# consent granted.
#
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=your-client-secret-value
#
# The target SharePoint site. Format: https://<tenant>.sharepoint.com/sites/<SiteName>
# SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/TeamsMonitor
#
# Optional: pick a specific document library (drive). If unset, the site's
# default library is used.
# SHAREPOINT_DRIVE_NAME=Documents
#
# Folder inside the drive where reports and CSV exports are stored. Created if
# it does not exist. Default: /TeamsCQM
# SHAREPOINT_FOLDER_PATH=/TeamsCQM
